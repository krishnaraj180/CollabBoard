# Used by `docker compose --profile full up --build` (copy to .env next to docker-compose.yml).
# For local npm development use server/.env.example and client/.env.example instead.
JWT_SECRET= collabboard-dev-secret-key-change-in-production
JWT_EXPIRES_IN=7d
SESSION_MAX_AGE_DAYS=7
CLIENT_ORIGIN=http://localhost:3000
# Where the BROWSER reaches the API/Socket.IO (your public API URL in production)
PUBLIC_API_URL=http://localhost:5000
# Show the "Fill demo account" button on the login page
DEMO_LOGIN=false
PASSWORD_RESET_URL=http://localhost:3000/reset-password
MAIL_FROM=CollabBoard <no-reply@example.com>
# Optional: enables real reset emails through Resend. Without this, development logs the reset link.
RESEND_API_KEY=
