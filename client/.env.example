# Used by Next.js server-side rewrites to reach the Express API.
API_URL=http://localhost:5000
# Optional browser-facing API origin. Set this to the Render API URL in production
# so the auth cookie is stored for the same origin used by the WebSocket connection.
NEXT_PUBLIC_API_URL=
# Used by the browser for the Socket.IO connection.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
